import { Button, VerticalBox, CheckBox, GroupBox, HorizontalBox, StyleMetrics, Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Password Generator";
    background: StyleMetrics.dark-color-scheme ? Palette.background : #fafafb;
    min-width: 380px;
    min-height: 280px;

    in-out property <bool> uppercase: true;
    in-out property <bool> lowercase: true;
    in-out property <bool> numbers: true;
    in-out property <bool> symbols: true;
    in-out property <string> password: "Press Generate";

    callback request-generate-password();
    callback request-copy-to-clipboard();

    GroupBox {
        VerticalBox {
            Rectangle {
                background: StyleMetrics.dark-color-scheme ? #2e2e32 : white;
                border-radius: 10px;
                border-width: 1px;
                border-color: StyleMetrics.dark-color-scheme ? transparent : #e3e3e4;
                HorizontalBox {
                    alignment: space-between;
                    Rectangle {
                        Text {
                            text <=> root.password;
                        }
                    }
                    Rectangle {
                        Image {
                            source: @image-url("../assets/copy.png");
                            colorize: StyleMetrics.dark-color-scheme ? #fafafb : #171717;
                        }
                        TouchArea {
                            clicked => { root.request-copy-to-clipboard(); }
                        }
                    }
                }
            }
            Rectangle {
                background: StyleMetrics.dark-color-scheme ? #2e2e32 : white;
                border-radius: 10px;
                border-width: 1px;
                border-color: StyleMetrics.dark-color-scheme ? transparent : #e3e3e4;
                HorizontalBox {
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Uppercase (A-Z)";
                            checked <=> root.uppercase;
                        }
                        CheckBox {
                            text: "Numbers (0-9)";
                            checked <=> root.numbers;
                        }
                    }
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Lowercase (a-z)";
                            checked <=> root.lowercase;
                        }
                        CheckBox {
                            text: "Symbols (!@#$)";
                            checked <=> root.symbols;
                        }
                    }
                }
            }
            Button {
                text: "Generate";
                primary: true;
                clicked => {
                    root.request-generate-password();
                }
            }
        }
    }
}
