import { Button, VerticalBox, CheckBox, GroupBox, HorizontalBox, StyleMetrics, Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Password Generator";
    background: StyleMetrics.dark-color-scheme ? Palette.background : #fafafb;
    min-width: 340px;
    min-height: 280px;
    in-out property <bool> uppercase: false;
    in-out property <bool> lowercase: false;
    in-out property <bool> numbers: false;
    in-out property <bool> symbols: false;
    callback request-generate-password();

    GroupBox {
        Rectangle {
            background: StyleMetrics.dark-color-scheme ? #2e2e32 : white;
            border-radius: 10px;
            VerticalBox {
                HorizontalBox {
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Uppercase (A-Z)";
                            checked <=> root.uppercase;
                        }
                        CheckBox {
                            text: "Numbers (0-9)";
                            checked <=> root.numbers;
                        }
                    }
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Lowercase (a-z)";
                            checked <=> root.lowercase;
                        }
                        CheckBox {
                            text: "Symbols (!@#$)";
                            checked <=> root.symbols;
                        }
                    }
                }
                Button {
                    text: "Generate";
                    primary: true;
                    clicked => {
                        root.request-generate-password();
                    }
                }
            }
        }
    }
}
