import { Button, VerticalBox, CheckBox, GroupBox, HorizontalBox, StyleMetrics, Palette, Slider } from "std-widgets.slint";
import { Card } from "card.slint";

export component AppWindow inherits Window {
    title: "Password Generator";
    background: StyleMetrics.dark-color-scheme ? Palette.background : #fafafb;
//    min-width: 380px;
//    min-height: 280px;

    in-out property <bool> uppercase: true;
    in-out property <bool> lowercase: true;
    in-out property <bool> numbers: true;
    in-out property <bool> symbols: true;
    in-out property <string> password: "Press Generate";
    in-out property <float> length: 16.0;

    callback request-generate-password();
    callback request-copy-to-clipboard();

    GroupBox {
        VerticalBox {
            padding: 30px;
            Card {
                HorizontalBox {
                    alignment: space-between;
                    Rectangle {
                        Text {
                            text <=> root.password;
                        }
                    }
                    Rectangle {
                        Image {
                            source: @image-url("../assets/copy.png");
                            colorize: StyleMetrics.dark-color-scheme ? #fafafb : #171717;
                        }
                        TouchArea {
                            clicked => { root.request-copy-to-clipboard(); }
                        }
                    }
                }
            }
            Card {
                HorizontalBox {
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Uppercase (A-Z)";
                            checked <=> root.uppercase;
                        }
                        CheckBox {
                            text: "Numbers (0-9)";
                            checked <=> root.numbers;
                        }
                    }
                    VerticalBox {
                        spacing: 20px;
                        CheckBox {
                            text: "Lowercase (a-z)";
                            checked <=> root.lowercase;
                        }
                        CheckBox {
                            text: "Symbols (!@#$)";
                            checked <=> root.symbols;
                        }
                    }
                }
            }
            Card {
                VerticalBox {
                    GroupBox {
                        title: "Lenght: " + Math.round(root.length);
                        Slider {
                            width: 100%;
                            minimum: 5;
                            maximum: 64;
                            value <=> root.length;
                            step: 1;
                        }
                    }
                }
            }
            Button {
                text: "Generate";
                primary: true;
                clicked => {
                    root.request-generate-password();
                }
            }
            HorizontalBox {
                alignment: center;
                Text {
                    text: "Made with ♥️ by DeimosHall";
                }
            }
        }
    }
}
